generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          UserRole  @default(CLIENT)
  companyName   String?
  contactName   String?
  phone         String?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  invoices                Invoice[]
  receipts                Receipt[]
  documents               Document[]
  contracts               Contract[]
  riskAssessments         RiskAssessment[]
  careHomes               CareHome[]
  quotations              Quotation[]
  completionCertificates  CompletionCertificate[]
}

model CareHome {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  address       String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoices                Invoice[]
  contracts               Contract[]
  riskAssessments         RiskAssessment[]
  quotations              Quotation[]
  completionCertificates  CompletionCertificate[]

  @@index([userId])
}

model CompletionCertificate {
  id                 String            @id @default(cuid())
  certificateNumber  String            @unique
  clientName         String
  clientAddress      String?
  clientContact      String?
  clientEmail        String?
  careHomeName       String?
  careHomeAddress    String?
  careHomeId         String?
  careHome           CareHome?         @relation(fields: [careHomeId], references: [id], onDelete: SetNull)
  userId             String?
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  status             CertificateStatus @default(DRAFT)
  worksDescription   String?
  workItems          Json?
  invoiceId          String?           @unique
  invoice            Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  completionDate     DateTime
  issuedDate         DateTime?
  boxesScanned       Int?
  filesScanned       Int?
  assessorName       String?           @default("Kevin Quirk")
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([careHomeId])
  @@index([invoiceId])
}

enum CertificateStatus {
  DRAFT
  ISSUED
}

model Quotation {
  id               String          @id @default(cuid())
  quoteNumber      String          @unique
  title            String          @default("Quotation for Archiving & Digitisation Services")
  clientName       String
  clientAddress    String?
  clientContact    String?
  clientEmail      String?
  careHomeName     String?
  careHomeAddress  String?
  careHomeId       String?
  careHome         CareHome?       @relation(fields: [careHomeId], references: [id], onDelete: SetNull)
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  status           QuotationStatus @default(DRAFT)
  scopeOfWorks     String?
  requirements     String?
  projectDuration  String?
  items            Json?
  subtotal         Float           @default(0)
  discountTotal    Float           @default(0)
  vatRate          Float           @default(20.0)
  vatAmount        Float           @default(0)
  total            Float           @default(0)
  depositPercent   Float?          @default(30)
  issueDate        DateTime        @default(now())
  validUntil       DateTime?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([careHomeId])
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtotal      Float
  vatRate       Float     @default(20.0)
  vatAmount     Float
  total         Float
  description   String
  items            Json?
  additionalItems  Json?
  depositPercent Float?   @default(50)
  careHomeId    String?
  careHome      CareHome? @relation(fields: [careHomeId], references: [id], onDelete: SetNull)
  careHomeName  String?
  careHomeAddress String?
  billTo             String    @default("CLIENT")
  showCompanyAddress Boolean   @default(true)
  vatOnBalanceOnly   Boolean   @default(false)
  depositPaid        Boolean   @default(false)
  status             InvoiceStatus @default(PENDING)
  issueDate     DateTime
  dueDate       DateTime
  paidDate      DateTime?
  fileUrl       String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completionCertificate CompletionCertificate?
  
  @@index([userId])
  @@index([careHomeId])
}

model Receipt {
  id              String    @id @default(cuid())
  receiptNumber   String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Float
  description     String
  paymentMethod   String    @default("Bank Transfer")
  date            DateTime
  careHomeName    String?
  careHomeAddress String?
  fileUrl         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model Document {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  category      DocumentCategory
  fileUrl       String
  fileSize      Int
  mimeType      String
  uploadedAt    DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([userId])
  @@index([category])
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  CLIENT
}

enum InvoiceStatus {
  PENDING
  DEPOSIT_PAID
  PAID
  OVERDUE
  CANCELLED
}

model ScanVaultDocument {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("GENERAL")
  fileUrl     String
  fileSize    Int      @default(0)
  mimeType    String   @default("application/pdf")
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model Lead {
  id          String    @id @default(cuid())
  type        LeadType
  name        String
  email       String
  phone       String?
  company     String?
  subject     String?
  service     String?
  message     String?
  emailSent   Boolean   @default(false)
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([createdAt])
}

model Contract {
  id               String         @id @default(cuid())
  title            String
  clientName       String
  clientAddress    String?
  clientContact    String?
  clientEmail      String?
  careHomeName     String?
  careHomeAddress  String?
  careHomeId       String?
  careHome         CareHome?      @relation(fields: [careHomeId], references: [id], onDelete: SetNull)
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  status           ContractStatus @default(DRAFT)
  pricePerBox      Float          @default(140)
  estimatedBoxes   Int?
  totalCost        Float?
  projectDuration  String?
  depositPercent   Float?         @default(30)
  scopeOfWorks     String?
  requirements     String?
  paymentTerms     String?
  startDate        DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model RiskAssessment {
  id               String    @id @default(cuid())
  careHomeName     String
  careHomeAddress  String?
  clientName       String
  clientAddress    String?
  careHomeId       String?
  careHome         CareHome? @relation(fields: [careHomeId], references: [id], onDelete: SetNull)
  assessorName     String?   @default("Kevin Quirk")
  workStartDate    DateTime?
  notes            String?
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([createdAt])
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LeadType {
  CONTACT
  QUOTE
}

model ExpenseReceipt {
  id            String          @id @default(cuid())
  expenseNumber String          @unique
  vendor        String
  amount        Float
  date          DateTime
  category      ExpenseCategory @default(OTHER)
  description   String?
  notes         String?
  fileUrl       String?
  fileName      String?
  mimeType      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model BankReconciliation {
  id           String   @id @default(cuid())
  filename     String
  transactions Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ExpenseCategory {
  OFFICE_SUPPLIES
  EQUIPMENT
  TRAVEL
  UTILITIES
  PROFESSIONAL_SERVICES
  MARKETING
  SOFTWARE
  WAGES
  OTHER
}

enum DocumentCategory {
  HR
  ADMIN
  CLIENT_RECORDS
  RESIDENT_RECORDS
  ACCOUNTS
  ARCHIVE
  OTHER
}
