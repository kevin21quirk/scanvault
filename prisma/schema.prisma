generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          UserRole  @default(CLIENT)
  companyName   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  invoices         Invoice[]
  receipts         Receipt[]
  documents        Document[]
  contracts        Contract[]
  riskAssessments  RiskAssessment[]
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtotal      Float
  vatRate       Float     @default(20.0)
  vatAmount     Float
  total         Float
  description   String
  items         Json?
  status        InvoiceStatus @default(PENDING)
  issueDate     DateTime
  dueDate       DateTime
  paidDate      DateTime?
  fileUrl       String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([userId])
}

model Receipt {
  id            String    @id @default(cuid())
  receiptNumber String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  description   String
  paymentMethod String    @default("Bank Transfer")
  date          DateTime
  fileUrl       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([userId])
}

model Document {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  category      DocumentCategory
  fileUrl       String
  fileSize      Int
  mimeType      String
  uploadedAt    DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([userId])
  @@index([category])
}

enum UserRole {
  ADMIN
  CLIENT
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Lead {
  id          String    @id @default(cuid())
  type        LeadType
  name        String
  email       String
  phone       String?
  company     String?
  subject     String?
  service     String?
  message     String?
  emailSent   Boolean   @default(false)
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([createdAt])
}

model Contract {
  id               String         @id @default(cuid())
  title            String
  clientName       String
  clientAddress    String?
  clientContact    String?
  clientEmail      String?
  careHomeName     String?
  careHomeAddress  String?
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  status           ContractStatus @default(DRAFT)
  pricePerBox      Float          @default(140)
  estimatedBoxes   Int?
  totalCost        Float?
  projectDuration  String?
  depositPercent   Float?         @default(30)
  scopeOfWorks     String?
  requirements     String?
  paymentTerms     String?
  startDate        DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model RiskAssessment {
  id               String    @id @default(cuid())
  careHomeName     String
  careHomeAddress  String?
  clientName       String
  clientAddress    String?
  assessorName     String?   @default("Kevin Quirk")
  workStartDate    DateTime?
  notes            String?
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([createdAt])
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LeadType {
  CONTACT
  QUOTE
}

enum DocumentCategory {
  HR
  ADMIN
  CLIENT_RECORDS
  RESIDENT_RECORDS
  ACCOUNTS
  ARCHIVE
  OTHER
}
